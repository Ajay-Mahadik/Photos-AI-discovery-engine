      "id": "d00c626b-48d9-4b2c-826b-787aa623e165",
      "name": "Format App Store"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\n// The HTTP Request node outputs the raw SerpApi JSON response here\nconst searchData = items[0].json; \n\n// Extract the array of Google search results\nconst organicResults = searchData.organic_results || [];\n\nfor (const result of organicResults) {\n  // Combine the Reddit thread title and the Google snippet for Gemini to analyze\n  const fullText = `${result.title || ''} \\n ${result.snippet || ''}`.trim();\n  \n  if (fullText.length > 20) {\n    output.push({\n      json: {\n        // The Reddit URL serves as a perfect unique ID for your deduplication loop\n        ID: result.link, \n        Source: 'Reddit (SerpApi)',\n        // SerpApi occasionally includes a 'date' field; otherwise default to today\n        Date: result.date || new Date().toISOString().split('T')[0], \n        URL: result.link,\n        Raw_Text: fullText\n      }\n    });\n  }\n}\n\nreturn output;"
      },
