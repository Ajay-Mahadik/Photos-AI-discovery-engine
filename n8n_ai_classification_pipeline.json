    {
      "parameters": {
        "jsCode": "const existingRows = $('Fetch Stored IDs').all();\nconst existingIDs = new Set(existingRows.map(row => String(row.json.ID || '')));\nconst incomingData = $('Merge').all(); \n\nconst noiseRegex = /storage|subscription|google one|syncing|backup stuck|payment|permanently deleted|recover deleted/i;\nconst output = [];\n\nfor (const item of incomingData) {\n  const data = item.json;\n  if (existingIDs.has(data.ID)) continue;\n  if (!data.Raw_Text || data.Raw_Text.length < 25) continue;\n\n  const isNoise = noiseRegex.test(data.Raw_Text);\n  output.push({\n    json: {\n      ...data,\n      Data_Status: isNoise ? 'Noise' : 'Valid_Retrieval',\n      Archetype: isNoise ? 'N/A' : '',\n      Retained_Memory: isNoise ? 'N/A' : '',\n      Forgotten_Metadata: isNoise ? 'N/A' : '',\n      Fallback_Behavior: isNoise ? 'N/A' : '',\n      Evidence_Quote: isNoise ? 'N/A' : '',\n      Friction_Severity: isNoise ? 'Low' : ''\n    }\n  });\n}\nreturn output;"
      },
