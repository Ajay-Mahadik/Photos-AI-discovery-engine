    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const aiData = items[i].json;\n  const originalData = $('Loop Over Items').itemMatching(i).json;\n\n  let parsed = null;\n  let errorReason = \"Parse Error\";\n  let diagnosticDump = \"\";\n\n  // 1. Did the node natively parse the JSON at the root level?\n  if (aiData && typeof aiData === 'object' && aiData.Archetype) {\n    parsed = aiData;\n  } \n  else {\n    // 2. The node didn't parse it. We must find the text string inside the Gemini API wrapper object.\n    let rawAiText = '';\n    \n    if (typeof aiData.text === 'string') {\n      rawAiText = aiData.text; \n    } else if (aiData.content?.parts?.[0]?.text && typeof aiData.content.parts[0].text === 'string') {\n      rawAiText = aiData.content.parts[0].text; // <-- The missing path revealed by your diagnostic dump!\n    } else if (aiData.parts?.[0]?.text && typeof aiData.parts[0].text === 'string') {\n      rawAiText = aiData.parts[0].text; \n    } else if (aiData.candidates?.[0]?.content?.parts?.[0]?.text) {\n      rawAiText = aiData.candidates[0].content.parts[0].text; \n    } else if (typeof aiData.message?.content === 'string') {\n      rawAiText = aiData.message.content; \n    } else if (typeof aiData.content === 'string') {\n      rawAiText = aiData.content;\n    } else if (typeof aiData === 'string') {\n      rawAiText = aiData;\n    }\n\n    // 3. Clean and parse the extracted text\n    if (rawAiText && rawAiText.trim().length > 0) {\n      try {\n        let cleaned = rawAiText.replace(/```json/gi, '').replace(/```/gi, '').trim();\n        const firstBrace = cleaned.indexOf('{');\n        const lastBrace = cleaned.lastIndexOf('}');\n        \n        if (firstBrace !== -1 && lastBrace !== -1) {\n          cleaned = cleaned.substring(firstBrace, lastBrace + 1);\n          parsed = JSON.parse(cleaned);\n        } else {\n          errorReason = \"No JSON brackets found in the extracted text\";\n          diagnosticDump = rawAiText;\n        }\n      } catch (err) {\n        parsed = null;\n        errorReason = \"Invalid JSON syntax inside the text\";\n        diagnosticDump = rawAiText; \n      }\n    } else {\n      errorReason = \"Could not locate the AI text string in the payload\";\n      diagnosticDump = JSON.stringify(aiData); \n    }\n  }\n\n  // 4. Output the final structured row\n  output.push({\n    json: {\n      ID: originalData.ID || '',\n      Source: originalData.Source || '',\n      Date: originalData.Date || '',\n      URL: originalData.URL || '',\n      Raw_Text: originalData.Raw_Text || '',\n      Data_Status: originalData.Data_Status || 'Valid_Retrieval',\n      \n      Archetype: parsed?.Archetype || errorReason,\n      Retained_Memory: parsed?.Retained_Memory || '',\n      Forgotten_Metadata: parsed?.Forgotten_Metadata || '',\n      Fallback_Behavior: parsed?.Fallback_Behavior || '',\n      Evidence_Quote: parsed?.Evidence_Quote || diagnosticDump.substring(0, 500), \n      Friction_Severity: parsed?.Friction_Severity || ''\n    },\n    pairedItem: i\n  });\n}\n\nreturn output;"
      },
