    {
      "parameters": {
        "jsCode": "const rawInput = $input.first().json;\n\n// 1. Extract payload from 'data' or the root object\nlet payload = rawInput.data !== undefined ? rawInput.data : rawInput;\n\n// 2. Parse the string into a JSON object if received as raw text\nif (typeof payload === 'string') {\n  try {\n    payload = JSON.parse(payload);\n  } catch (error) {\n    payload = {};\n  }\n}\n\n// 3. Extract review entries\nconst entries = payload.feed?.entry || [];\n\n// Apple's first entry (index 0) is app metadata; user reviews start at index 1\nreturn entries.slice(1).map(entry => ({\n  json: {\n    ID: entry.id?.label || `appstore-${Math.random().toString(36).substring(2, 9)}`,\n    Source: 'Apple App Store',\n    Date: entry.updated?.label ? entry.updated.label.split('T')[0] : new Date().toISOString().split('T')[0],\n    URL: entry.author?.uri?.label || 'App Store',\n    Raw_Text: `${entry.title?.label || ''}. ${entry.content?.label || ''}`.trim()\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
