      "parameters": {
        "jsCode": "// Ensure we are pulling the reviews array from the HTTP node output\nconst reviews = $input.all()[0].json.reviews || [];\n\nreturn reviews.map(review => ({\n  json: {\n    ID: review.id || `playstore-${Math.random().toString(36).substr(2, 9)}`,\n    Source: 'Google Play Store',\n    Date: review.date ? new Date(review.date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0],\n    URL: 'https://play.google.com/store/apps/details?id=com.google.android.apps.photos',\n    Raw_Text: review.text ? review.text.trim() : '' // Target the correct Play Store payload field\n  }\n}));"
      },
